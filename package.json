{
  "name": "thermomatrix-card",
  "version": "1.5.0",
  "packageManager": "pnpm@11.25.0",
  "description": "A modular LCD-style climate card for Home Assistant",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
